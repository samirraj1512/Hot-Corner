# Existing application settings
MONGODB_URI=
CLERK_SECRET_KEY=
CLIENT_URL=http://localhost:5174

# Shared Socket.IO state on Vercel. Use the rediss:// connection string from Upstash/Vercel.
WATCH_TOGETHER_REDIS_URL=

# Choose one TURN configuration for reliable browser video calls.
# Option A: Metered TURN (recommended for a hosted relay).
METERED_TURN_DOMAIN=your-app.metered.live
# Create one Metered TURN credential in the Metered dashboard and copy its API key here.
METERED_TURN_API_KEY=
# Or mint expiring credentials with the Metered Developers secret plus a TURN Project ID.
# METERED_TURN_SECRET_KEY=
# METERED_TURN_PROJECT_ID=
# METERED_TURN_CREDENTIAL_TTL_SECONDS=7200
# METERED_TURN_CREDENTIAL_LABEL=
# Force a valid TURN relay for restrictive networks. The server safely falls back to "all" if no relay is ready.
# WATCH_TOGETHER_ICE_TRANSPORT_POLICY=relay

# Option B: a coturn server using --use-auth-secret and --static-auth-secret.
# WATCH_TOGETHER_TURN_URLS=turn:turn.example.com:80,turn:turn.example.com:80?transport=tcp,turns:turn.example.com:443?transport=tcp
# WATCH_TOGETHER_TURN_SHARED_SECRET=

# Optional fixed ICE server array. Keep this server-only; never use a VITE_ variable for TURN credentials.
# WATCH_TOGETHER_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]

# Required only when a Google Drive video is MKV/HEVC or another browser-incompatible format.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Direct browser-to-storage uploads for large MP4/WebM Watch Together videos.
# Create an R2 S3 API token with access limited to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hot-corner-watch-together
# Optional. Default is 10 GB. This is a server-side abuse/cost guard, not an R2 platform limit.
WATCH_TOGETHER_R2_MAX_FILE_SIZE_GB=10
